	</script>
  <script type="text/javascript">

function formatState (state) {
	var elem = state.element;
	if(elem == null) return state.text;
	var tagName = elem.tagName;
	var exclude = ['', 'other_va'];
	if(tagName != 'OPTION' || (exclude.includes(elem.value))) {
		return $(`<b>${state.text}</b>`);
	}
  var res = `
		<div class="payment-method-item">
			<div class="payment-method-item-image">
				<img src="${state.element.getAttribute('data-img')}" />
			</div>
			<div class="payment-method-item-text">
				${state.text}
			</div>
		</div>
	`;
  return $(res);
};
  $(document).ready(function() {
			// $('#doa').on('hidden.bs.modal', function (e) {
			// 	$('body').addClass("modal-open");
			// });

			$('#paymentMethodDonasi,#paymentMethodZakat').select2({
				templateResult: formatState,
				templateSelection: formatState,
			});
			$('#doa-zakat').on('hidden.bs.modal', function (e) {
				$('body').addClass("modal-open");
			});

      $('.open-modal').click(function(){
          var target = $(this).attr('data-target');

          $('#'+target+'.modal-box').fadeIn(300);
          // $('body').css('overflow', 'hidden');
      });

      $('.modal-box .modal-box-bg').click(function(){
          $('.modal-box').fadeOut(300);
          // $('body').css('overflow', 'auto');
      });

      $('.modal-box .modal-box-section-close').click(function(){
          $('.modal-box').fadeOut(300);
          // $('body').css('overflow', 'auto');
      });

			$('.btn-nominal').click(function(){
				var val =	$(this).val();
				$('#nominalDonasi').val(val);
			});

			$('.btn-jenis-zakat').click(function(){
				var val =	$(this).val();
				$('.btn-jenis-zakat').removeClass('active');
				$(this).addClass('active');
				$('#jenisZakat').val(val);
			});

			$('#zakat_perdagangan_btn').click(function(){
				var nominal = $('#zakat_harta').val().replace(/\./g, '');
				$('#nominalZakat').val(parseInt(nominal));
				$('#kalkulatorZakat').modal('hide');
			});

			$('#zakat_emas_btn').click(function(){
				var nominal = $('#zakat_total_uang').val().replace(/\./g, '');
				$('#nominalZakat').val(parseInt(nominal));
				$('#kalkulatorZakat').modal('hide');
			});

			$('#zakat_tabungan_btn').click(function(){
				var nominal = $('#zt_zakat_harta').val().replace(/\./g, '');
				$('#nominalZakat').val(parseInt(nominal));
				$('#kalkulatorZakat').modal('hide');
			});

			$('#zakat_penghasilan_btn').click(function(){
				var nominal = $('#zp_zakat_harta').val().replace(/\./g, '');
				$('#nominalZakat').val(parseInt(nominal));
				$('#kalkulatorZakat').modal('hide');
			});

			@if (auth()->check() && auth()->user()->is_internal)
			$('.btn-copy-referral').on('click', function() {
				var link = "{{ url() . '/?r=' . auth()->user()->code_referral }}";

				navigator.clipboard.writeText(link).then(function(clipText) {
					alert("{{ trans('homepage.salin_link_referral') }}");
				});
			});
			@endif
  });
  </script>
