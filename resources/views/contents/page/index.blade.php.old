	function submitFormInfak() {
			// Kirim request ajax
			$('#loading-infak').show();
			$('#btn-infak').hide();
			$.post("{{ url('midtrans/store/donation') }}",
			{
					_method: 'POST',
					_token: '{{ csrf_token() }}',
					amount: $('input#nominalDonasi').val().replace(/\D/g,''),
					fullname: $('input#fullnameDonasi').val(),
					phone: $('input#phoneDonasi').val(),
					email: $('input#emailDonasi').val(),
					is_anonim: $('input:checked#is_anonim_infak').val(),
					payment_method: $('select#paymentMethodDonasi').val(),
					code_referral: $('#code-referral').val() || undefined
			},
			function (data) {
					var amount = $('input#nominalDonasi').val().replace(/\D/g,'');
					fbq('track', 'Purchase', {
						content_name: 'infak_umum',
						currency: 'IDR',
						value: amount,
						content_ids: ['infak_umum'],
						contents: [{'id': 'infak_umum', 'quantity': amount}]
					});

					$('input#nominalDonasi').val('');
					$('input#fullnameDonasi').val('');
					$('input#phoneDonasi').val('');
					$('input#emailDonasi').val('');

					$('#loading-infak').hide();
					$('#btn-infak').show();
					// var paymentMethod = $('select#paymentMethodDonasi').val();

					// if (paymentMethod.includes("transfer_")) {
						// manual transfer
						$('#successPayment .modal-body').html(data);
						$('#successPayment').modal('show');
						// $('#doa').modal('show');
					// }else {
						// midtrans
					// 	snap.pay(data.snap_token, {
					// 			showOrderId: false,
					// 			language: 'id',
					// 			onSuccess: function (result) {
					// 					location.reload();
					// 			},
					// 			onPending: function (result) {
					// 					location.reload();
					// 			},
					// 			onError: function (result) {
					// 					location.reload();
					// 			}
					// 	});
					// }
			});
			return false;
	}
	function submitFormZakat() {
			// Kirim request ajax
			$('#loading-zakat').show();
			$('#btn-zakat').hide();
			$.post("{{ url('midtrans/store/zakat') }}",
			{
					_method: 'POST',
					_token: '{{ csrf_token() }}',
					type: $('input#jenisZakat').val(),
					amount: $('input#nominalZakat').val().replace(/\D/g,''),
					fullname: $('input#fullnameZakat').val(),
					phone: $('input#phoneZakat').val(),
					email: $('input#emailZakat').val(),
					is_anonim: $('input:checked#is_anonim_zakat').val(),
					payment_method: $('select#paymentMethodZakat').val(),
					code_referral: $('#code-referral').val() || undefined
			},
			function (data, status) {
					var amount = $('input#nominalZakat').val().replace(/\D/g,'');
					var type = 'zakat_' + $('input#jenisZakat').val().toLowerCase();
					fbq('track', 'Purchase', {
						content_name: type,
						currency: 'IDR',
						value: amount,
						content_ids: [type],
						contents: [{'id': type, 'quantity': amount}]
					});

					$('input#nominalZakat').val('');
					$('input#fullnameZakat').val('');
					$('input#phoneZakat').val('');
					$('input#emailZakat').val('');

					$('#loading-zakat').hide();
					$('#btn-zakat').show();

					// var paymentMethod = $('select#paymentMethodZakat').val();

